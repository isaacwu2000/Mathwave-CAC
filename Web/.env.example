# Server-only API key. Add your own value to the ignored .env file.
OPENAI_API_KEY=
# Neon pooled application connection. Keep credentials server-only.
DATABASE_URL=
# Auth service URL for the same Neon branch as DATABASE_URL.
NEON_AUTH_BASE_URL=
# At least 32 random characters; sign guest cookies and auth cache cookies.
NEON_AUTH_COOKIE_SECRET=
# Provision with scripts/setup-auth.ts. Never commit actual values.
MATHWAVE_TEST_EMAIL=agent-test@mathwave.invalid
MATHWAVE_TEST_PASSWORD=
MATHWAVE_DEVELOPMENT_USER_ID=
# Shared guest abuse ceiling; individual browser trial remains 3 minutes.
GUEST_IP_MONTHLY_HOURS=1000
# Explicit loopback-only, sign-in-free synthetic evaluation mode.
CLOUD_TEST_MODE=false
