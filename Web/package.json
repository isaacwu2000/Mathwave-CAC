{
  "name": "math-audio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "VINEXT_NO_DEV_LOCK=1 vinext dev",
    "dev:open": "MATH_AUDIO_DEV_OPEN=true pnpm run dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint . \"$(cd ../Evals && pwd)\" \"$(cd ../Training/LLM/scripts && pwd)\"",
    "format": "oxfmt . \"$(cd ../Evals && pwd)\" \"$(cd ../Training/LLM/scripts && pwd)\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:train": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/evaluate.ts train parser",
    "eval:test": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/evaluate.ts test parser",
    "eval:agent": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/evaluate.ts test endpoint",
    "check:setup": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-setup.mjs",
    "migrate:cloud": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-cloud.ts",
    "test:watch": "vitest",
    "check:boundaries": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-boundaries.ts",
    "verify": "pnpm run check:boundaries && pnpm run test && pnpm run typecheck && pnpm run lint && pnpm run build"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@base-ui/react": "1.7.0",
    "@neondatabase/auth": "0.6.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "html-to-image": "^1.11.13",
    "input-otp": "1.4.2",
    "jspdf": "^4.2.1",
    "lucide-react": "1.31.0",
    "mathlive": "0.110.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "0.186.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@babel/types": "7.29.8",
    "@cloudflare/vite-plugin": "1.54.6",
    "@cloudflare/workers-types": "5.20260908.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "^5.0.4",
    "wrangler": "4.130.0",
    "postcss": "8.5.30",
    "ws": "8.21.0",
    "@types/ws": "8.18.2"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
